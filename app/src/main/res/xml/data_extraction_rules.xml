<?xml version="1.0" encoding="utf-8"?><!--
   UncleCarbon holds credentials and trigger secrets, so none of its data may leave
   the device. The Device Owner re-enables the system backup service for
   Seedvault; android:allowBackup="false" blocks cloud backup on Android 12+ but
   not device-to-device transfer, so every domain is excluded from both.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The device_* (device-protected storage) domains are valid at runtime
   (android.app.backup.FullBackup) but unknown to AGP 8.2's lint, which would
   otherwise fail release builds with FullBackupContent false positives.
-->
<data-extraction-rules
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FullBackupContent">
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
