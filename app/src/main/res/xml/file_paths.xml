<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Only the dedicated shareable directories are exposed (see util/StorageLayout).
        Do NOT map the files/ or cache/ roots: they hold preferences, keys and
        anti-rollback state that must never be reachable through a content URI.
    -->
    <files-path name="evidence_files" path="evidence/" />
    <files-path name="diagnostics_files" path="diagnostics/" />
</paths>
