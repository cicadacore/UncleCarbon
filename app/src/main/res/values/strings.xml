    <string name="otc_tokens_title">Single-Use Emergency Wipe Token</string>
    <string name="otc_tokens_desc">Generates a single one-time emergency wipe token. When the valid unused token is received, UncleCarbon consumes it and requests a standard Device Owner factory reset. Generating a new token replaces any previous one, so there is always exactly one active token.</string>
