    <!-- Safe Boot Interception -->
    <string name="safe_boot_title">Safe Boot Interception (Anti-Bypass)</string>
    <string name="safe_boot_switch_label">Block Safe Boot (Device Owner)</string>
    <string name="safe_boot_summary">When enabled, the Device Owner refuses reboots into Android Safe Mode so adversaries cannot neutralize UncleCarbon sentinels by holding hardware keys at boot.</string>
    <string name="safe_boot_warning_title">Allow Safe Mode?</string>
    <string name="safe_boot_warning_message">Allowing Safe Mode lets anyone with physical access reboot the device into Safe Mode, which disables UncleCarbon background sentinels. Are you sure?</string>
    <string name="safe_boot_allow_button">Allow Safe Mode</string>
    <string name="safe_boot_keep_blocked_button">Keep Blocked</string>

    <!-- Developer / Debugging Interception (independent of Safe Boot) -->
    <string name="dev_interception_title">Developer Interception (Anti-Debug)</string>
    <string name="dev_interception_switch_label">Block Developer / Debugging Features (Device Owner)</string>
    <string name="dev_interception_summary">When enabled, the Device Owner blocks Android debugging features to prevent USB/ADB debugging from being enabled. This is independent of Safe Boot interception.</string>

