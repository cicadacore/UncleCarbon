    <!-- Safe Boot Interception -->
    <string name="safe_boot_title">Safe Boot Interception (Anti-Bypass)</string>
    <string name="safe_boot_switch_label">Block Safe Boot (Device Owner)</string>
    <string name="safe_boot_summary">When enabled, the Device Owner refuses reboots into Android Safe Mode so adversaries cannot neutralize UncleTed sentinels by holding hardware keys at boot.</string>
    <string name="safe_boot_warning_title">Allow Safe Mode?</string>
    <string name="safe_boot_warning_message">Allowing Safe Mode lets anyone with physical access reboot the device into Safe Mode, which disables UncleTed background sentinels. Are you sure?</string>
    <string name="safe_boot_allow_button">Allow Safe Mode</string>
    <string name="safe_boot_keep_blocked_button">Keep Blocked</string>

