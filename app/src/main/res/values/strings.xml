    <!-- Destruction Protocol (standard Device Owner factory reset only) -->
    <string name="destruction_title">Standard Factory Reset Controls</string>
    <string name="destruction_desc">Device Owner standard factory reset is the only destructive action in this GrapheneOS fork. Level 2/3/4 kernel/raw-partition routines were removed because they require root or raw block device access that is unavailable on an unrooted locked GrapheneOS install.</string>
    <string name="feature_wipe_device">Allow Factory Reset on Critical Alerts</string>
    <string name="feature_hardware_wipe">Rapid Volume Sequence Factory Reset</string>
    <string name="feature_hardware_wipe_summary">Press VOL UP → VOL DOWN → VOL UP → VOL DOWN quickly to invoke a standard Device Owner factory reset. Requires UncleCarbon\'s Accessibility Service to be enabled.</string>
    <string name="destruction_level_1_title">Standard Device Owner Factory Reset</string>
    <string name="destruction_level_1_desc">Invokes DevicePolicyManager.wipeDevice() on Android 14+ or wipeData() on earlier supported versions. External storage is included; the device reboots and user data is removed.</string>
    <string name="destruction_execute_level_1">Execute Standard Factory Reset</string>
    <string name="feature_wipe_on_sim_replacement">Factory Reset on SIM Replacement</string>

