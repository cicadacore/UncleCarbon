    <!-- Destruction Protocols: optional eSIM/eUICC erasure on wipe -->
    <string name="erase_esim_title">Erase eSIM on Wipe</string>
    <string name="erase_esim_switch_label">Erase eSIM/eUICC profiles during factory reset</string>
    <string name="erase_esim_summary">When enabled, UncleCarbon requests deletion of eSIM/eUICC profiles whenever it performs a device wipe. This does not affect normal Lock/BFU actions.</string>

