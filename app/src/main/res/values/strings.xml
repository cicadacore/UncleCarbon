    <!-- Physical Proximity & Dead-Man Tripwires -->
    <string name="proximity_tripwire_title">Proximity &amp; Dead-Man Tripwires</string>
    <string name="ble_proximity_title">BLE Proximity Sentinel</string>
    <string name="ble_proximity_desc">Monitors a configured Bluetooth device. If the Bluetooth device is no longer detected nearby for the configured period, UncleCarbon will reboot the phone into BFU using Device Owner controls.</string>
    <string name="ble_proximity_toggle">Enable BLE Proximity Sentinel</string>
    <string name="ble_target_mac_hint">Trusted BLE Device MAC Address</string>
    <string name="ble_rssi_threshold_hint">Signal Cutoff RSSI (dBm, Default: -85)</string>
    <string name="ble_breach_limit_hint">Consecutive Missed Heartbeats (Default: 3)</string>
    <string name="deadman_tripwire_title">Dead-Man Wipe Sentinel</string>
    <string name="deadman_tripwire_desc">When the device becomes locked, UncleCarbon starts the Dead-Man Wipe Sentinel countdown. Successfully unlocking the device resets the countdown. If the device remains locked for the configured period, the standard wipe protocol is triggered. No manual check-in is required and network connectivity does not affect the countdown.</string>
    <string name="deadman_toggle_label">Enable Dead-Man Wipe Sentinel</string>
    <string name="deadman_duration_hint">Locked Duration Before Wipe</string>
    <string name="btn_custom_tripwire_duration">Set Custom Locked Duration (Days)</string>
    <string name="tripwire_custom_dialog_title">Custom Dead-Man Duration</string>
    <string name="geofence_suicide_title">Multi-Zone Geographic Suicide</string>
    <string name="geofence_suicide_desc">Checks framework location fixes against the configured zone polygons. After several consecutive accurate fixes inside a zone, UncleCarbon requests a standard Device Owner factory reset.</string>
    <string name="geofence_evin_toggle">Evin Prison Perimeter Sentinel (Auto-Wipe)</string>
    <string name="geofence_manage_zones_button">Manage Custom Destruction Zones</string>

    <!-- Covert Signaling & Remote C2 -->
    <string name="remote_signaling_title">Covert Signaling &amp; Remote C2</string>
